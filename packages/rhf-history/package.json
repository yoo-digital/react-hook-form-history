{
  "name": "@yoo-digital/rhf-history",
  "version": "0.0.0",
  "description": "Undo/redo for react-hook-form that scales to thousands of fields.",
  "keywords": [
    "react-hook-form",
    "undo",
    "redo",
    "history",
    "react",
    "forms"
  ],
  "license": "MIT",
  "author": {
    "name": "YOO AG",
    "email": "info@yoo.digital",
    "url": "https://www.yoo.digital/"
  },
  "contributors": [
    {
      "name": "Tobias Maier",
      "email": "tobias.maier@yoo.digital"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoo-digital/react-hook-form-history.git",
    "directory": "packages/rhf-history"
  },
  "homepage": "https://github.com/yoo-digital/react-hook-form-history/tree/main/packages/rhf-history#readme",
  "bugs": "https://github.com/yoo-digital/react-hook-form-history/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@yoo-digital/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "@yoo-digital/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest",
    "test:run": "vitest run",
    "bench": "vitest bench --run",
    "check:pkg": "pnpm run build && publint --strict --pack pnpm && T=$(mktemp -d) && pnpm pack --pack-destination \"$T\" >/dev/null && attw \"$T\"/*.tgz --profile esm-only",
    "prepublishOnly": "test -f dist/index.js || (echo 'dist/ is missing: run pnpm build before publishing' >&2 && exit 1)"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-hook-form": "^7.55.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@hookform/resolvers": "^7.0.7",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1"
  }
}
