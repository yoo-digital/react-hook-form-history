  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoo-digital/react-hook-form-history.git"
  },
  "author": {
    "name": "YOO AG",
    "email": "info@yoo.digital",
    "url": "https://www.yoo.digital/"
  },
  "contributors": [
    {
      "name": "Tobias Maier",
      "email": "tobias.maier@yoo.digital"
    }
  ],
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm -F react-vite dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:run": "pnpm -r test:run",
    "bench": "pnpm -r bench",
    "e2e": "pnpm -F e2e test",
