    "@yoo-digital/oxfmt-config": "~0.1.0",
    "@yoo-digital/oxlint-config-react": "~0.1.0",
    "@yoo-digital/oxlint-config-vitest": "~0.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "~7.0.2"
  }
